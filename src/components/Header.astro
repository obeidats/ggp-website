---
import Icon from './Icon.astro';
import { nav, site } from '@/config/site';
import { href, otherLang, swapLang, tr, useT, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  overlay?: boolean;
}
const { lang, overlay = false } = Astro.props;
const t = useT(lang);
const target = otherLang(lang);

const current = Astro.url.pathname;
const isActive = (path: string) => {
  const url = href(lang, path);
  return path === '' ? current === url : current.startsWith(url);
};
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a href={href(lang)} class="brand" aria-label={`${tr(site.name, lang)} — ${t('nav.home')}`}>
      <img class="logo logo-dark" src="/brand/logo.svg" alt="" width="289" height="83" />
      <img class="logo logo-light" src="/brand/logo-light.svg" alt="" width="289" height="83" />
    </a>

    <nav class="nav" aria-label={t('nav.main')}>
      <ul role="list" class="nav-list" id="site-menu">
        {
          nav.map((item) => (
            <li>
              <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
                {t(item.key)}
              </a>
            </li>
          ))
        }
        <li class="nav-mobile-extra">
          <a class="btn" href={site.phoneHref}><Icon name="Phone" size={18} />{site.phone}</a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a
        class="lang-switch"
        href={swapLang(current, target)}
        hreflang={target}
        lang={target}
        aria-label={t('lang.switchLabel')}
        data-lang-switch={target}>
        <Icon name="Languages" size={18} />
        <span>{t('lang.switch')}</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden" data-label-open>{t('nav.menu')}</span>
        <span class="visually-hidden" data-label-close hidden>{t('nav.close')}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  // Solid header once the page scrolls
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-label-open]')?.toggleAttribute('hidden', open);
    toggle.querySelector('[data-label-close]')?.toggleAttribute('hidden', !open);
  };
  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('menu-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Remember the visitor's language for their next visit to the root URL
  document.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    try {
      localStorage.setItem('ggp-lang', (e.currentTarget as HTMLAnchorElement).dataset.langSwitch ?? '');
    } catch {}
  });
  try {
    localStorage.setItem('ggp-lang', document.documentElement.lang);
  } catch {}
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: rgba(245, 247, 248, 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-block-end: 1px solid transparent;
    transition: background-color 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  .site-header.scrolled { border-color: var(--line); box-shadow: 0 8px 30px -20px rgba(10, 26, 43, 0.5); }

  /* Transparent over a dark hero until scrolled */
  .site-header.overlay { position: fixed; inset-inline: 0; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .site-header.overlay.scrolled { background: rgba(10, 26, 43, 0.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--line-dark); }

  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }

  .brand { display: block; flex: none; }
  .logo { height: 54px; width: auto; }
  .logo-light { display: none; }
  .overlay .logo-dark { display: none; }
  .overlay .logo-light { display: block; }

  .nav-list { display: flex; align-items: center; gap: clamp(0.5rem, 1.6vw, 2rem); }
  .nav-list a:not(.btn) {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--ink);
    transition: color 0.2s;
  }
  .overlay .nav-list a:not(.btn) { color: var(--text-on-dark); }
  .nav-list a:not(.btn)::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: scaleX(0);
    transition: transform 0.3s var(--ease);
  }
  .nav-list a:not(.btn):hover::after,
  .nav-list a[aria-current='page']::after { transform: scaleX(1); }
  .nav-list a[aria-current='page'] { color: var(--gold-deep); }
  .overlay .nav-list a[aria-current='page'] { color: var(--gold-light); }
  .nav-mobile-extra { display: none; }

  .actions { display: flex; align-items: center; gap: 0.6rem; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--gold);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    transition: background-color 0.25s, color 0.25s;
  }
  .lang-switch[lang='ar'] { font-family: 'IBM Plex Sans Arabic', 'Segoe UI', sans-serif; }
  .lang-switch[lang='en'] { font-family: 'Inter', system-ui, sans-serif; }
  .lang-switch:hover { background: var(--gold); color: var(--ink); }
  .overlay .lang-switch { color: var(--text-on-dark); }
  .overlay .lang-switch:hover { color: var(--ink); }

  .menu-toggle { display: none; width: 46px; height: 46px; border: 0; border-radius: 50%; background: var(--ink); place-items: center; }
  .burger { display: grid; gap: 5px; width: 20px; }
  .burger span { display: block; height: 2px; border-radius: 2px; background: var(--gold-light); transition: transform 0.3s var(--ease), opacity 0.2s; }
  .menu-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-open .burger span:nth-child(2) { opacity: 0; }
  .menu-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1023px) {
    .menu-toggle { display: grid; }
    .logo { height: 46px; }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--ink);
      padding: 2rem var(--gutter);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity 0.3s, transform 0.35s var(--ease), visibility 0.3s;
    }
    .menu-open .nav { opacity: 1; visibility: visible; transform: none; }
    .menu-open.site-header { background: var(--ink); }
    .menu-open .logo-dark { display: none; }
    .menu-open .logo-light { display: block; }
    .menu-open .lang-switch { color: var(--text-on-dark); }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list li { border-block-end: 1px solid var(--line-dark); }
    .nav-list a:not(.btn) { display: block; padding-block: 1.1rem; font-size: var(--step-2); font-family: var(--font-display); color: var(--text-on-dark) !important; }
    .nav-list a:not(.btn)::after { display: none; }
    .nav-list a[aria-current='page'] { color: var(--gold-light) !important; }
    .nav-mobile-extra { display: block; border: 0 !important; padding-block-start: 2rem; }
    .nav-mobile-extra .btn { width: 100%; }
  }
  @media (max-width: 420px) {
    .lang-switch { padding-inline: 0.75rem; }
    .lang-switch :global(svg) { display: none; }
    .logo { height: 40px; }
  }
</style>

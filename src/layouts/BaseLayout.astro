---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/config/site';
import { dirOf, langs, swapLang, tr, useT, type Lang } from '@/i18n/ui';
import { photos } from '@/data/photos';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Header starts transparent over a full-bleed hero. */
  overlayHeader?: boolean;
  ogImage?: ImageMetadata;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, overlayHeader = false, ogImage = photos.muttrahCorniche.src, jsonLd } = Astro.props;
const t = useT(lang);
const siteName = tr(site.name, lang);
const fullTitle = title === siteName ? `${siteName} | ${site.shortName}` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(swapLang(Astro.url.pathname, l), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(swapLang(Astro.url.pathname, 'en'), Astro.site).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a1a2b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_OM' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      lang === 'ar' ? (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@500;700&display=swap"
        />
      ) : (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        />
      )
    }

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal elements as they scroll into view
      const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-visible'));
      }

      // Animated number counters: <span data-count="23711224" data-decimals="0">
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const fmt = (n: number, d: number) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
      const run = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const decimals = Number(el.dataset.decimals ?? 0);
        if (reduce) return;
        const start = performance.now();
        const dur = 1600;
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(target * eased, decimals);
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = fmt(target, decimals);
        };
        requestAnimationFrame(tick);
      };
      if ('IntersectionObserver' in window) {
        const co = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                run(e.target as HTMLElement);
                co.unobserve(e.target);
              }
            }
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => co.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-inline-start: 1rem;
    top: -100px;
    z-index: 200;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
    font-weight: 700;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 1rem; }
  main:focus { outline: none; }
</style>
